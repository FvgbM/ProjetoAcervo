# Copie este arquivo para .env e substitua todos os valores antes de iniciar o stack.
# Nunca versione o arquivo .env.
MYSQL_APP_PASSWORD=<senha-forte-do-usuario-acervo_app>
MYSQL_ROOT_PASSWORD=<senha-forte-do-root-mysql>
# Gere uma chave única com: openssl rand -base64 32
FILE_ENCRYPTION_KEY_BASE64=<chave-base64-de-exatos-32-bytes>
# Portas expostas apenas no ambiente local.
FRONTEND_PORT=8080
MAILPIT_UI_PORT=8025
